# Copy this to .env for local development and .env.production for the
# production build (Vercel reads env vars from its dashboard instead —
# see below).

# Local backend (Spring Boot running on your machine)
VITE_API_BASE_URL=http://localhost:8080/api

# Production: set this in Vercel's Project Settings -> Environment Variables
# instead of committing it here. Example value:
# VITE_API_BASE_URL=https://medicharm-backend.onrender.com/api
