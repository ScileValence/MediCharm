###
# ===========================================================
# Ownership checks (should return 403 when the IDs don't match
# the logged-in caller)
# ===========================================================

### Logged in as patient A, try to read patient B's appointments
### -> expect 403 "You are not authorized to view these appointments"
GET http://localhost:8080/api/appointments/user/999
Authorization: Bearer PASTE_PATIENT_A_TOKEN_HERE

### Logged in as patient A, try to read patient B's order history
### -> expect 403 "You are not authorized to view these orders"
GET http://localhost:8080/api/orders/user/999
Authorization: Bearer PASTE_PATIENT_A_TOKEN_HERE

### Logged in as patient A, try to cancel patient B's order
### -> expect 403 "You are not authorized to cancel this order"
PUT http://localhost:8080/api/orders/999/cancel
Authorization: Bearer PASTE_PATIENT_A_TOKEN_HERE

### Logged in as patient A, try to read patient B's medical reports
### -> expect 403 "You are not authorized to view these reports"
GET http://localhost:8080/api/reports/user/999
Authorization: Bearer PASTE_PATIENT_A_TOKEN_HERE

### Logged in as Doctor X, try to confirm an appointment assigned
### to Doctor Y -> expect 403 "You are not authorized to act on this appointment"
PUT http://localhost:8080/api/appointments/999/confirm
Authorization: Bearer PASTE_OTHER_DOCTOR_TOKEN_HERE

### Try to cancel an appointment that is already COMPLETED
### -> expect 500 with message "Cannot cancel an appointment that is already completed"
PUT http://localhost:8080/api/appointments/1/cancel
Authorization: Bearer PASTE_PATIENT_TOKEN_HERE

