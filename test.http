POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "password123"
}

###
# ===========================================================
# Admin Module (v1.5) — run create_admin.sql once first
# ===========================================================

### Admin login (reuses the normal patient login endpoint;
### CustomUserDetailsService grants ROLE_ADMIN because role=ADMIN)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@medicharm.com",
  "password": "Admin@123"
}

### Copy the "token" value from the login response above and paste it
### below to authenticate the remaining admin requests.

### Dashboard stats
GET http://localhost:8080/api/admin/stats
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### List all patients
GET http://localhost:8080/api/admin/users
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Delete a patient (also removes their appointments + reports)
DELETE http://localhost:8080/api/admin/users/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### List all appointments (including cancelled ones, unlike the
### patient/doctor-facing endpoints which hide cancelled records)
GET http://localhost:8080/api/admin/appointments
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Cancel an appointment as admin
PUT http://localhost:8080/api/admin/appointments/1/cancel
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Permanently delete an appointment record
DELETE http://localhost:8080/api/admin/appointments/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### List all medicine orders
GET http://localhost:8080/api/admin/orders
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Cancel an order as admin
PUT http://localhost:8080/api/admin/orders/1/cancel
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Permanently delete an order record
DELETE http://localhost:8080/api/admin/orders/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### List all medical reports
GET http://localhost:8080/api/admin/reports
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Permanently delete a report (also deletes its file attachment)
DELETE http://localhost:8080/api/admin/reports/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### List all doctors (any status — public endpoint, no token needed)
GET http://localhost:8080/api/doctors/all

### Approve a pending doctor (admin-only)
PUT http://localhost:8080/api/doctors/approve/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Reject a pending doctor (admin-only)
PUT http://localhost:8080/api/doctors/reject/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Suspend an approved doctor (admin-only)
PUT http://localhost:8080/api/doctors/suspend/1
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

###
# ===========================================================
# Appointment status transitions (doctor/admin only)
# ===========================================================

### Doctor login (to get a doctor token for the requests below)
POST http://localhost:8080/api/auth/doctor/login
Content-Type: application/json

{
  "email": "doctor@example.com",
  "password": "password123"
}

### Confirm a pending appointment
PUT http://localhost:8080/api/appointments/1/confirm
Authorization: Bearer PASTE_DOCTOR_TOKEN_HERE

### Reject a pending appointment
PUT http://localhost:8080/api/appointments/1/reject
Authorization: Bearer PASTE_DOCTOR_TOKEN_HERE

### Mark a confirmed appointment as completed
PUT http://localhost:8080/api/appointments/1/complete
Authorization: Bearer PASTE_DOCTOR_TOKEN_HERE

### Full appointment history for a patient (includes cancelled/rejected)
GET http://localhost:8080/api/appointments/user/1/history
Authorization: Bearer PASTE_PATIENT_TOKEN_HERE

