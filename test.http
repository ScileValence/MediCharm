###
# ===========================================================
# Forgot / reset password
# ===========================================================

### Request a reset link (patient). Always returns the same generic
### success message whether or not the email exists. If SMTP isn't
### configured in application.properties, check the backend console
### output for the reset link instead of an inbox.
POST http://localhost:8080/api/auth/forgot-password
Content-Type: application/json

{
  "email": "test@example.com",
  "accountType": "PATIENT"
}

### Request a reset link (doctor)
POST http://localhost:8080/api/auth/forgot-password
Content-Type: application/json

{
  "email": "priya.nambiar@medicharm.com",
  "accountType": "DOCTOR"
}

### Complete the reset using the token from the email (or console log)
POST http://localhost:8080/api/auth/reset-password
Content-Type: application/json

{
  "token": "PASTE_TOKEN_FROM_EMAIL_OR_CONSOLE_HERE",
  "newPassword": "myNewPassword789"
}

### Admin: generate a temporary password for a doctor (no email
### needed — returns the plaintext temp password once, in the response)
POST http://localhost:8080/api/admin/doctors/1/reset-password
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

### Admin: generate a temporary password for a patient
POST http://localhost:8080/api/admin/users/1/reset-password
Authorization: Bearer PASTE_ADMIN_TOKEN_HERE

###
# ===========================================================
# In-app notifications
# ===========================================================

### Get my notifications (works for either a patient or doctor token —
### the backend resolves which based on the JWT's role)
GET http://localhost:8080/api/notifications/me
Authorization: Bearer PASTE_PATIENT_OR_DOCTOR_TOKEN_HERE

### Get my unread count (polled by the frontend bell every 30s)
GET http://localhost:8080/api/notifications/unread-count
Authorization: Bearer PASTE_PATIENT_OR_DOCTOR_TOKEN_HERE

### Mark a single notification as read
PUT http://localhost:8080/api/notifications/1/read
Authorization: Bearer PASTE_PATIENT_OR_DOCTOR_TOKEN_HERE

### Mark all of my notifications as read
PUT http://localhost:8080/api/notifications/read-all
Authorization: Bearer PASTE_PATIENT_OR_DOCTOR_TOKEN_HERE

### End-to-end test: schedule an appointment as a patient, then check
### GET /api/notifications/me with the DOCTOR's token — should show
### a new "New appointment request" notification.
POST http://localhost:8080/api/appointments/schedule
Authorization: Bearer PASTE_PATIENT_TOKEN_HERE
Content-Type: application/json

{
  "userId": "1",
  "department": "Cardiology",
  "doctor": "Dr. Arjun Mehta",
  "date": "2026-07-15",
  "time": "10:30",
  "description": "Routine checkup"
}